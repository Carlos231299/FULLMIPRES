# ─────────────────────────────────────────────────────────────
# MIPRES Backend - Variables de Entorno
# Copia este archivo como ".env" y ajusta los valores
# ─────────────────────────────────────────────────────────────

# Puerto del servidor Express
PORT=3001

# Host donde escucha el servidor
# Desarrollo local: 127.0.0.1 (solo localhost)
# Servidor/Producción: 0.0.0.0 (todas las interfaces)
HOST=127.0.0.1

# Modo de ejecución
NODE_ENV=development

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password_aqui
DB_NAME=mipres_db

# URL base de la API MIPRES/SISPRO
MIPRES_BASE_URL=https://wsmipres.sispro.gov.co/WSSUMMIPRESNOPBS/api

# CORS: dominio(s) del frontend en producción (separados por coma si son varios)
# Dejar vacío en desarrollo para aceptar cualquier origen
# Credenciales para el panel administrativo (/admin)
ADMIN_USER=admin
ADMIN_PASSWORD=admin123
