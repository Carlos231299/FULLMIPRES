# ─────────────────────────────────────────────────────────────
# MIPRES - Variables de Entorno
# Copia este archivo como ".env" y ajusta los valores
# ─────────────────────────────────────────────────────────────

# URL del backend (Express). En producción cámbiala al dominio del servidor.
VITE_API_BASE_URL=http://127.0.0.1:3001/api

# Puerto del servidor backend (usado por server.js)
PORT=3001

# Modo de ejecución: development | production
NODE_ENV=development
